# ─────────────────────────────────────────────────────────────
# Sentinel QC Server — environment configuration
# Copy to `.env` and fill in. The server runs with heuristics
# when the LLAMA service isn't available.
# ─────────────────────────────────────────────────────────────

PORT=8787
CORS_ORIGIN=http://localhost:5173

# ── LLAMA Service ──────────────────────────────────────────
# URL of the local Python LLAMA service (inference + training).
# Start it with: python llama_service/app.py
LLAMA_SERVICE_URL=http://localhost:8788

# ── LLAMA Model (set in the Python service) ────────────────
# LLAMA_MODEL=meta-llama/Llama-3.2-3B-Instruct
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
