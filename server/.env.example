# ─────────────────────────────────────────────────────────────
# Content QC Server — environment configuration
# Copy to `.env` and fill in. Everything is optional: with no keys
# the server runs in "fallback" mode (heuristics only) so the app
# is fully usable before credentials are provisioned.
# ─────────────────────────────────────────────────────────────

PORT=8787
# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGIN=http://localhost:5173

# ── Anthropic / Claude ──────────────────────────────────────
# Powers the RAG-adapted Claude engine + one side of the ensemble.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ── Google Gemini (AI Studio API key) ───────────────────────
# Used for inference + embeddings when Vertex is not configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ── Google Cloud Vertex AI (real fine-tuning) ───────────────
# Required for REAL per-exam supervised fine-tuning jobs.
# Point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON
# with the "Vertex AI User" role.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# Base model to fine-tune (Vertex supervised tuning target).
VERTEX_TUNE_BASE_MODEL=gemini-2.5-flash
# GCS bucket (name only, no gs://) that holds tuning datasets. The service
# account above needs objectAdmin on it. Required for real tuning jobs.
GCS_BUCKET=
